  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://tccrixoiuxbczrbyksyr.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "pixel-perfect",
      "version": "0.1.0",
      "title": "Pixel Perfect"
    },
    "tools": [
