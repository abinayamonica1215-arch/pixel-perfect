        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "full_name": {
              "description": "Full name",
              "type": "string",
              "maxLength": 100
            },
            "college": {
              "description": "College or university",
              "type": "string",
              "maxLength": 150
            },
            "skills": {
              "description": "Comma-separated skills",
              "type": "string",
              "maxLength": 500
            },
            "github_url": {
              "description": "GitHub profile URL",
              "type": "string",
              "maxLength": 300
            },
            "portfolio_url": {
              "description": "Portfolio URL",
              "type": "string",
              "maxLength": 300
            },
            "bio": {
              "description": "Short bio",
              "type": "string",
              "maxLength": 1000
            }
